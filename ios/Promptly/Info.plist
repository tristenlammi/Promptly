<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Promptly</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>PromptlyServerHost</key>
	<string>$(PROMPTLY_SERVER_HOST)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>promptly</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Promptly connects to your own server when it is on your home network.</string>
	<key>NSCameraUsageDescription</key>
	<string>Promptly uses the camera to scan a pairing code, for video calls, and when you take a photo or scan a page to add to your files.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Promptly uses the microphone for calls, voice rooms, voice messages, and when you talk to the assistant or dictate.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Promptly saves photos and videos you download to your photo library when you ask it to.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Promptly shows where you are on its map and uses it for directions. Your location goes only to your own server.</string>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>org.promptly.rooms</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Rooms</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>bubble.left.and.bubble.right</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>org.promptly.mail</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Mail</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>envelope</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>org.promptly.calendar</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Calendar</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>calendar</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>org.promptly.photos</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Photos</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>photo.on.rectangle</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>org.promptly.settings</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>This iPhone</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>iphone</string>
		</dict>
	</array>
</dict>
</plist>
