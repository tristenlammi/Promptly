<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Photos and videos: Android 13+ asks for each; older asks for storage. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Keeps where a photo was taken in the copy sent (Photos' map). -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- P Maps: the driving screen and the timeline read the phone's GPS. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Only if you turn the timeline on, and pick "Allow all the time". -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The assistant, when you ask for it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Set a timer": no prompt, and only through the phone's clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- The car's screen. -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <!-- Only for "Back up right away instead" — asked, never assumed. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Installing an update the app has downloaded and checked against its hash. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Hides other apps' overlays over the unlock and fill screens, where Android allows it. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Only what Chrome's documented autofill-state provider asks of a caller. -->
    <uses-permission android:name="android.permission.READ_USER_DICTIONARY" />
    <!-- Notes: a voice note keeps recording with the screen locked (only while you record). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:name=".SyncApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_promptly"
        android:roundIcon="@mipmap/ic_promptly"
        android:label="Promptly"
        android:manageSpaceActivity="org.promptly.app.ManageData"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Photo backup (was the PromptlySync app). No icon of its own: long-press
             P Photos → Backup settings, or "Set up on this phone" on the server. -->
        <activity
            android:name=".MainActivity"
            android:label="Photo backup"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="org.promptly.app.backup"
            android:windowSoftInputMode="adjustResize">
            <!-- "Already installed? Open the app" on the server's /sync page. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="promptlysync" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- P Maps. The web app opens these for what a web page can't do. -->
        <activity
            android:name=".maps.NavigationActivity"
            android:label="P Maps"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="org.promptly.app.maps"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="promptlymaps" android:host="navigate" />
            </intent-filter>
        </activity>
        <activity
            android:name=".maps.TimelineActivity"
            android:label="Your timeline"
            android:exported="true"
            android:taskAffinity="org.promptly.app.maps">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="promptlymaps" android:host="timeline" />
            </intent-filter>
        </activity>
        <service
            android:name="com.stadiamaps.ferrostar.core.service.FerrostarForegroundService"
            android:foregroundServiceType="location" />
        <service
            android:name=".maps.TimelineService"
            android:foregroundServiceType="location" />
        <receiver android:name=".maps.TimelineBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The phone's assistant: Default apps → Digital assistant app. Android
             lists this because of the service and its xml; the gesture goes to the
             session, which opens the sheet. -->
        <service
            android:name=".assistant.PromptlyAssistantService"
            android:exported="true"
            android:label="Promptly"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/voice_interaction_service" />
        </service>
        <service
            android:name=".assistant.PromptlySessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service
            android:name=".assistant.PromptlyRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>
        <activity
            android:name=".assistant.AssistantActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Promptly"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="org.promptly.app.assistant"
            android:theme="@style/Theme.Promptly.AssistantSheet">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".assistant.AssistantSettingsActivity"
            android:exported="true"
            android:label="Phone assistant"
            android:taskAffinity="org.promptly.app.assistant.settings" />

        <!-- Android Auto. -->
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="2" />
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <service
            android:name=".maps.PromptlyCarService"
            android:label="P Maps"
            android:icon="@mipmap/ic_promptly"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- Passwords: the native vault. Its launcher is an alias so the Choose apps
             picker can hide the icon without turning off autofill's own screens. -->
        <activity
            android:name=".passwords.ui.PasswordsActivity"
            android:label="P Passwords"
            android:icon="@mipmap/ic_passwords"
            android:roundIcon="@mipmap/ic_passwords"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="org.promptly.app.passwords"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:label="Add to Passwords">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="org.promptly.app.PasswordsLauncher"
            android:targetActivity=".passwords.ui.PasswordsActivity"
            android:label="P Passwords"
            android:icon="@mipmap/ic_passwords"
            android:roundIcon="@mipmap/ic_passwords"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".passwords.autofill.PromptlyAutofillService"
            android:exported="true"
            android:label="Promptly Passwords"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/pw_autofill_service" />
        </service>
        <activity
            android:name=".passwords.autofill.AutofillAuthActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="Passwords"
            android:taskAffinity="org.promptly.app.passwords.fill"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".passwords.autofill.AutofillSaveActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="Passwords"
            android:taskAffinity="org.promptly.app.passwords.fill"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".passwords.credentials.PromptlyCredentialProviderService"
            android:enabled="@bool/pw_credential_provider"
            tools:targetApi="34"
            android:exported="true"
            android:label="Promptly Passwords"
            android:icon="@mipmap/ic_passwords"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data android:name="android.credentials.provider" android:resource="@xml/pw_credential_provider" />
        </service>
        <activity
            android:name=".passwords.credentials.CredentialActivity"
            android:enabled="@bool/pw_credential_provider"
            tools:targetApi="34"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="Passwords"
            android:taskAffinity="org.promptly.app.passwords.fill"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".passwords.PasswordsTileService"
            android:exported="true"
            android:icon="@drawable/pw_key"
            android:label="Passwords"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- A checked update, given to Android's package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>

        <!-- WorkManager's foreground service, for long backups. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Notes widgets (org.promptly.sync.widgets, docs/notes-plan.md §9): the
             home-screen widgets, their settings, quick capture and refreshes. -->
        <receiver
            android:name=".widgets.AgendaWidgetReceiver"
            android:label="@string/wg_agenda_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/wg_agenda_info" />
        </receiver>
        <receiver
            android:name=".widgets.TasksWidgetReceiver"
            android:label="@string/wg_tasks_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/wg_tasks_info" />
        </receiver>
        <!-- Boot, the clock or time zone changing, the widgets' own redraw alarm, and
             a P app being opened (SuiteLauncher's explicit broadcast). -->
        <receiver android:name=".widgets.WidgetEvents" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".widgets.AgendaConfigActivity"
            android:label="Agenda widget"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="org.promptly.app.widgets">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".widgets.TasksConfigActivity"
            android:label="Tasks widget"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="org.promptly.app.widgets">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".widgets.OpenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Promptly.Invisible" />
        <activity
            android:name=".capture.QuickTaskActivity"
            android:label="Quick task"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="org.promptly.app.capture"
            android:theme="@style/Theme.Promptly.Capture"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- Notes widgets (W1.3): Notes and One note, quick note, voice note, the
             One note widget's +, and Share to Notes from other apps. -->
        <receiver
            android:name=".widgets.NotesWidgetReceiver"
            android:label="@string/wg_notes_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/wg_notes_info" />
        </receiver>
        <receiver
            android:name=".widgets.OneNoteWidgetReceiver"
            android:label="@string/wg_one_note_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/wg_one_note_info" />
        </receiver>
        <activity
            android:name=".widgets.NotesConfigActivity"
            android:label="Notes widget"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="org.promptly.app.widgets">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".widgets.OneNoteConfigActivity"
            android:label="One note widget"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="org.promptly.app.widgets"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- P Notes' long-press shortcuts (android/gen_suite.py) open these two. -->
        <activity
            android:name=".capture.QuickNoteActivity"
            android:label="New note"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="org.promptly.app.capture"
            android:theme="@style/Theme.Promptly.Capture"
            android:windowSoftInputMode="adjustResize|stateVisible" />
        <activity
            android:name=".capture.VoiceNoteActivity"
            android:label="Voice note"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="org.promptly.app.voice"
            android:theme="@style/Theme.Promptly.Capture" />
        <activity
            android:name=".capture.AddItemActivity"
            android:label="Add to list"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="org.promptly.app.capture"
            android:theme="@style/Theme.Promptly.Capture"
            android:windowSoftInputMode="adjustResize|stateVisible" />
        <activity
            android:name=".capture.ShareToNotesActivity"
            android:label="Promptly Notes"
            android:icon="@mipmap/ic_promptly"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="org.promptly.app.share"
            android:theme="@style/Theme.Promptly.Capture"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:label="Promptly Notes">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter android:label="Promptly Notes">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
        <!-- Only while a voice note records (a notification says so). -->
        <service
            android:name=".capture.RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Passwords: seeing an app's signing certificate is how it's told apart from an
             impostor with the same package name. Launchable apps and browsers, not "all
             packages". Chrome's channels for its documented settings provider. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <!-- The updater hands its file to the system's installer by name. -->
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <package android:name="com.android.chrome" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.chrome.canary" />
    </queries>
</manifest>
