<?xml version="1.0" encoding="utf-8"?>
<!-- At-a-glance widget: Countdown. Refreshed by WorkManager (widgets-refresh), not by updatePeriodMillis. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/wg_countdown_description"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="60dp"
    android:minResizeHeight="60dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:configure="org.promptly.sync.widgets.CountdownConfigActivity"
    android:widgetFeatures="reconfigurable" />
