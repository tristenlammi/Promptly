<?xml version="1.0" encoding="utf-8"?>
<!-- A widget's glass background (day): frosted white the wallpaper shows
     through, a bright rim and a highlight across the top. Android can't blur
     behind a widget, so the tint keeps dark text readable on any wallpaper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:angle="270" android:startColor="#A6FFFFFF" android:endColor="#80F5F2EE" />
        </shape>
    </item>
    <item android:bottom="40dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" />
            <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
</layer-list>
