<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Notes widgets: quick capture opens over the home screen, no window of its own. -->
    <style name="Theme.Promptly.Capture" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize|stateVisible</item>
    </style>
    <!-- The trampoline a widget tap goes through: nothing to see. -->
    <style name="Theme.Promptly.Invisible" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoDisplay">true</item>
    </style>
</resources>
