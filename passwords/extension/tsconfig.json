{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types", "../../frontend/node_modules/@types"],
    "types": ["chrome"],
    "paths": {
      "react": ["../../frontend/node_modules/@types/react"],
      "react/jsx-runtime": ["../../frontend/node_modules/@types/react/jsx-runtime"],
      "react-dom/client": ["../../frontend/node_modules/@types/react-dom/client"],
      "qrcode": ["../../frontend/node_modules/@types/qrcode"],
      "*": ["../../frontend/node_modules/*"]
    }
  },
  "include": ["src"]
}
