{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Promptly Passwords",
  "version": "0.2.0",
  "identifier": "org.promptly.passwords",
  "mainBinaryName": "promptly-passwords",
  "build": {
    "frontendDist": "../ui-dist",
    "beforeBuildCommand": { "script": "node build-ui.mjs", "cwd": ".." }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src blob:; connect-src ipc: http://ipc.localhost; worker-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'",
      "dangerousDisableAssetCspModification": true,
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "publisher": "Promptly",
    "shortDescription": "Promptly Passwords",
    "longDescription": "Your passwords, end-to-end encrypted, on your own Promptly server.",
    "license": "MIT",
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "installerHooks": "installer-hooks.nsh" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
