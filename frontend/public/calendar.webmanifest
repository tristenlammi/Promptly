{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "name": "Promptly Calendar",
  "short_name": "Calendar",
  "description": "A calendar for you, your family and friends on your own Promptly — shared calendars, invitations and reminders.",
  "id": "/calendar/",
  "start_url": "/calendar/?source=pwa",
  "scope": "/calendar/",
  "display": "standalone",
  "background_color": "#FAF9F7",
  "theme_color": "#4F7FE0",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/item-icons/calendar-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/item-icons/calendar-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/item-icons/calendar-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
