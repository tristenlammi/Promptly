{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "name": "Passwords",
  "short_name": "Passwords",
  "description": "Your passwords and 2FA codes, end-to-end encrypted, on your own Promptly.",
  "id": "/passwords/",
  "start_url": "/passwords/?source=pwa",
  "scope": "/passwords/",
  "display": "standalone",
  "background_color": "#FAF9F7",
  "theme_color": "#D97757",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "security"
  ],
  "icons": [
    {
      "src": "/item-icons/passwords-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/item-icons/passwords-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/item-icons/passwords-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
